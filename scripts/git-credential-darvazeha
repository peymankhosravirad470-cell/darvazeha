#!/usr/bin/env bash
# git credential helper — minimal, read-only implementation of the
# git-credential protocol for github.com only.
#
# The secret lives OUTSIDE the repository at:
#   ~/.config/darvazeha/github.token   (chmod 600, parent dir 700)
# This script contains no secret and is safe to commit.
#
# Install (once, local only — never committed):
#   git config credential.helper "$PWD/scripts/git-credential-darvazeha"
set -euo pipefail
op="${1:-}"; [ "$op" = "get" ] || exit 0
f="$HOME/.config/darvazeha/github.token"
[ -r "$f" ] || exit 0
proto=""; host=""
while IFS= read -r line; do
  case "$line" in
    protocol=*) proto="${line#protocol=}" ;;
    host=*)     host="${line#host=}" ;;
    url=*)      u="${line#url=}"
                case "$u" in
                  https://github.com/*) proto="https"; host="github.com" ;;
                esac ;;
  esac
done
[ "$proto" = "https" ] && [ "$host" = "github.com" ] || exit 0
printf 'username=peymankhosravirad470-cell\n'
printf 'password=%s\n' "$(cat "$f")"
